# =============================================================================
# JobQuestTG Bot - Systemd Service (direct python, minimal)
# =============================================================================
# No memory monitoring, no hang detection, no exponential backoff.
# Systemd restarts the process on crash. That's it.
# =============================================================================

[Unit]
Description=Job Search Telegram Bot
Documentation=https://github.com/alwinpaul1/Job-Search-TG
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/Job-Search-TG
ExecStart=/root/Job-Search-TG/.venv/bin/python -u /root/Job-Search-TG/bot.py

# Restart on crash. No memory-based triggers, no backoff escalation.
Restart=on-failure
RestartSec=10

LimitNOFILE=65536
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=job-search-bot

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/root

TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
